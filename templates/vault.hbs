<section class="actor-vault">
  <header class="actor-vault__toolbar">
    <div>
      <strong>{{title}}</strong>
      <div class="hint">Only one copy exists: active in the world or stored in the vault.</div>
    </div>
    <div class="actor-vault__totals">
      <span>Active: {{activeCount}}</span>
      <span>Stored: {{storedCount}}</span>
    </div>
  </header>

  <section class="actor-vault__resources">
    <div class="actor-vault__resources-heading">
      <div>
        <h2>Player Dashboard</h2>
        <div class="hint">Account-level resources shared by all of this player's characters.</div>
      </div>
      {{#if isGM}}
      <label>
        <span>Player</span>
        <select data-resource-user>
          {{#each users}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
          {{/each}}
        </select>
      </label>
      {{else}}
      <strong>{{resourceUserName}}</strong>
      {{/if}}
    </div>

    <form data-resource-form data-user-id="{{resourceUserId}}">
      <div class="actor-vault__resource-grid">
        <label><span>Gold</span><input type="number" name="gold" value="{{resources.gold}}" step="1"></label>
        <label><span>Server Credits</span><input type="number" name="credits" value="{{resources.credits}}" step="1"></label>
        <label><span>Experience</span><input type="number" name="xp" value="{{resources.xp}}" step="1"></label>
      </div>
      <h3>Magic Item Storage</h3>
      <div class="actor-vault__storage-grid">
        <label><span>Slot 1</span><input type="text" name="s0" value="{{resources.storage.0}}"></label>
        <label><span>Slot 2</span><input type="text" name="s1" value="{{resources.storage.1}}"></label>
        <label><span>Slot 3</span><input type="text" name="s2" value="{{resources.storage.2}}"></label>
        <label><span>Slot 4</span><input type="text" name="s3" value="{{resources.storage.3}}"></label>
      </div>
      <div class="actor-vault__resource-actions">
        <button type="button" data-action="save-resources"><i class="fas fa-floppy-disk"></i> Save Dashboard</button>
      </div>
    </form>
  </section>

  {{#unless playersFolderFound}}
  <div class="actor-vault__warning">
    Create an Actor folder named <strong>Players</strong>. Only actors inside that folder or its subfolders are managed.
  </div>
  {{/unless}}

  <div class="actor-vault__columns">
    <section>
      <h2>{{localize "ACTORVAULT.Active"}}</h2>
      {{#each activeGroups}}
      <div class="actor-vault__group">
        <h3>{{name}}</h3>
        <div class="actor-vault__list">
          {{#each actors}}
          <article class="actor-vault__row" data-actor-id="{{id}}">
            <img src="{{img}}" alt="">
            <div class="actor-vault__identity">
              <strong>{{name}}</strong>
              <span>{{type}} · {{ownerName}}</span>
            </div>
            {{#if ../../isGM}}
            <label class="actor-vault__owner-label">
              <span>Owner</span>
              <select data-owner-select data-actor-id="{{id}}">
                <option value="">Unassigned</option>
                {{#each ../../users}}
                <option value="{{id}}" {{#if (eq id ../ownerId)}}selected{{/if}}>{{name}}</option>
                {{/each}}
              </select>
            </label>
            {{/if}}
            <button type="button" data-action="archive" data-id="{{id}}"><i class="fas fa-box-archive"></i> {{localize "ACTORVAULT.Archive"}}</button>
          </article>
          {{/each}}
        </div>
      </div>
      {{else}}
      <p class="actor-vault__empty">{{localize "ACTORVAULT.NoActors"}}</p>
      {{/each}}
    </section>

    <section>
      <h2>{{localize "ACTORVAULT.Stored"}}</h2>
      {{#each storedGroups}}
      <div class="actor-vault__group">
        <h3>{{name}}</h3>
        <div class="actor-vault__list">
          {{#each actors}}
          <article class="actor-vault__row actor-vault__row--stored" data-pack-id="{{id}}">
            <img src="{{img}}" alt="">
            <div class="actor-vault__identity">
              <strong>{{name}}</strong>
              <span>{{type}} · {{ownerName}}</span>
            </div>
            <button type="button" data-action="activate" data-id="{{id}}"><i class="fas fa-arrow-up-from-bracket"></i> {{localize "ACTORVAULT.Activate"}}</button>
          </article>
          {{/each}}
        </div>
      </div>
      {{else}}
      <p class="actor-vault__empty">{{localize "ACTORVAULT.NoActors"}}</p>
      {{/each}}
    </section>
  </div>
</section>
